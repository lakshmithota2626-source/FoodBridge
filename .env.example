# ============================================================
# FoodBridge — Environment Variables
# Copy to server/.env for local development. Never commit .env
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL  (Render provides this automatically via Blueprint)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodbridge
DB_SSL=false          # set to true for hosted providers (Render, Supabase, etc.)

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# CORS — only needed for local dev (separate Vite dev server).
# In production (single-domain), leave this unset or blank.
CLIENT_URL=http://localhost:5173

# Cloudinary — optional. Without it donations save without a photo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
